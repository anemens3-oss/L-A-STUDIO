# ============================================================================
# LÉA STUDIO — Переменные серверного окружения (без секретов в репозитории)
# ============================================================================

# Секреты официального Telegram Bot API (https://core.telegram.org/bots/api)
# В production устанавливаются через:
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SHA-256 хеш пароля администратора (никогда не храните пароль открытым текстом)
# Для генерации: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('ВашСекретныйПароль').digest('hex'))"
ADMIN_PASSWORD_SHA256=""

# Порт и путь к локальной SQLite БД (при локальном запуске через node server.js)
PORT="3000"
DB_FILE=".data/lea-studio.sqlite"
